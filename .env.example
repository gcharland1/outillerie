# Copier vers .env et remplir. Lu par docker compose (racine) et par l'app en développement.
POSTGRES_DB=outillerie
POSTGRES_USER=outillerie
POSTGRES_PASSWORD=
POSTGRES_DATA_PATH=./data/postgres

# Utilisés par l'app dès que la base et la session y sont branchées.
DATABASE_URL=postgresql+psycopg://outillerie:<mot de passe>@localhost:5430/outillerie
FLASK_SECRET_KEY=

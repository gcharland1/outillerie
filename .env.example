# Valeurs de développement local : `cp .env.example .env` suffit pour démarrer.
# Lu par docker compose (racine) et par l'app en développement. Aucun secret réel ici.
POSTGRES_DB=outillerie
POSTGRES_USER=outillerie
POSTGRES_PASSWORD=outillerie
POSTGRES_DATA_PATH=./data/postgres

DATABASE_URL=postgresql+psycopg://outillerie:outillerie@localhost:5430/outillerie
FLASK_SECRET_KEY=dev-seulement
FLASK_ENVIRONMENT=development

# Envoi des courriels (ADR 0027). Tous requis hors développement ; en développement, sans
# SMTP_HOST, les courriels sont écrits dans le journal de l'app.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_SENDER=
SITE_URL=

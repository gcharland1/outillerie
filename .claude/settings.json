{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run --locked pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run flask db:*)",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(openspec:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(docker compose down:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Bash(cat .env:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "env": {
    "OPENSPEC_TELEMETRY": "0"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-python.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/export-transcript.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
